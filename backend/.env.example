# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# Encryption (run: python -c "from services.encryption import generate_key; print(generate_key())")
ENCRYPTION_KEY=your-32-byte-base64-key

# JWT
JWT_SECRET=your-random-jwt-secret

# Gmail OAuth (console.cloud.google.com)
GMAIL_CLIENT_ID=your-gmail-client-id
GMAIL_CLIENT_SECRET=your-gmail-client-secret
GMAIL_REDIRECT_URI=http://localhost:8000/auth/gmail/callback

# Outlook OAuth (portal.azure.com)
OUTLOOK_CLIENT_ID=your-outlook-client-id
OUTLOOK_CLIENT_SECRET=your-outlook-client-secret
OUTLOOK_REDIRECT_URI=http://localhost:8000/auth/outlook/callback

# Frontend
FRONTEND_URL=http://localhost:3000

# AI — Groq (free, recommended)
# Get key at: https://console.groq.com  →  free tier, no credit card needed
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=llama-3.1-8b-instant

# AI — Ollama (optional local fallback, only if you want it)
OLLAMA_BASE_URL=http://localhost:11434
